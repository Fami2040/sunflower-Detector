{
  "schema_version": "gpu_queue_manifest.v1",
  "description": "Post–P0-5 zoo backlog: CPU domain/tray audit refresh, top-3 weak-tray finetune (stage 1→2 per tray), head-ROI eval smoke. Run only after gpu_queue_zoo_p0_5.json (or archive/gpu_queue_full.json zoo_matrix_p0_5) verifies matrix_train.json. Checklist: docs/manuscript/status.md.",
  "require_before": {
    "matrix_train": {
      "train_out": "reports/hsp/matrix_train.json",
      "matrix_group": "zoo_yolo_only",
      "accept_skipped_no_weights": false
    }
  },
  "defaults": {
    "locked_conf_from": "reports/hsp/threshold_val.json",
    "weak_plan": "reports/domains/weak_tray_plan.json",
    "tide_summary": "reports/hsp/tide_bucket_summary.json",
    "base_weights": "models/best2.pt",
    "finetune_base_selection": "reports/hsp/finetune_base_selection.json",
    "min_free_mib": 5500,
    "env": {
      "HARCHOC_MAX_BATCH": "1",
      "PYTHONUNBUFFERED": "1"
    }
  },
  "jobs": [
    {
      "id": "domain_tray_audit_refresh",
      "kind": "domain_tray_audit_refresh",
      "backlog": ["P1-DOMAIN-AUDIT", "DATA-ACQ-GEN"],
      "estimated_minutes": 45,
      "mamba": false,
      "merge_mamba": true,
      "catalog": "reports/domains/catalog.json",
      "domains_dir": "data/domains",
      "domain_eval": "reports/domains/domain_eval.json",
      "count_mae": "reports/domains/domain_count_mae.json",
      "weak_plan_out": "reports/domains/weak_tray_plan.json",
      "top_k": 3,
      "global_mae": 61.3,
      "device": "0",
      "rationale": "Refresh weak-tray ranking from per-tray count MAE @ val-locked conf before finetune GPU jobs; requires DATASET_ROOT and existing domain_eval.v1.",
      "notes": "Stages: eval_domains --write-domain-splits; --merge-tray-count-mae (mamba/torch); experiment.py domain-tray-audit → weak_plan_out. Re-runs when invoked (no skip_if on weak_plan)."
    },
    {
      "id": "finetune_weak_tray_1",
      "kind": "finetune_tray",
      "backlog": ["P1-FINETUNE-TRAY"],
      "tray_key": "3a5-9",
      "stage": 1,
      "train_config": "configs/experiments/finetune_tray_stage1.json",
      "transfer_config": "configs/transfer/finetune_stage1.yaml",
      "train_mode": "tray_adapt",
      "weak_plan": "reports/domains/weak_tray_plan.json",
      "skip_if_missing_plan": true,
      "mamba": true,
      "device": "0",
      "env": {"HARCHOC_EXPORT_DEVICE": "0"},
      "run_name": "finetune_3a5-9_s1",
      "out": "reports/transfer/finetune_queue_finetune_weak_tray_1.json",
      "estimated_minutes": 90,
      "hyperparams": {
        "epochs": 25,
        "lr": 0.001,
        "imgsz": 1280,
        "batch": 1,
        "freeze_backbone": true,
        "patience": 10
      },
      "rationale": "Weak-tray rank #1: tray_adapt when TIDE Loc+Bkg dominates (tide_bucket_summary); stage-1 frozen backbone matches finetune.py --stage 1 defaults.",
      "skip_if": {"finetune_out": "reports/transfer/finetune_queue_finetune_weak_tray_1.json"},
      "notes": "Follow with stage-2 job (finetune_tray_stage2.json, base_weights=stage-1 best.pt) after s1 completes."
    },
    {
      "id": "finetune_weak_tray_2",
      "kind": "finetune_tray",
      "backlog": ["P1-FINETUNE-TRAY"],
      "tray_key": "350",
      "stage": 1,
      "train_config": "configs/experiments/finetune_tray_stage1.json",
      "transfer_config": "configs/transfer/finetune_stage1.yaml",
      "train_mode": "tray_adapt",
      "weak_plan": "reports/domains/weak_tray_plan.json",
      "skip_if_missing_plan": true,
      "mamba": true,
      "device": "0",
      "env": {"HARCHOC_EXPORT_DEVICE": "0"},
      "run_name": "finetune_350_s1",
      "out": "reports/transfer/finetune_queue_finetune_weak_tray_2.json",
      "estimated_minutes": 90,
      "hyperparams": {
        "epochs": 25,
        "lr": 0.001,
        "imgsz": 1280,
        "batch": 1,
        "freeze_backbone": true,
        "patience": 10
      },
      "rationale": "Weak-tray rank #2 from domain_tray_audit_refresh; same stage-1 protocol as finetune_weak_tray_1.",
      "skip_if": {"finetune_out": "reports/transfer/finetune_queue_finetune_weak_tray_2.json"}
    },
    {
      "id": "finetune_weak_tray_3",
      "kind": "finetune_tray",
      "backlog": ["P1-FINETUNE-TRAY"],
      "tray_key": "200-3-1",
      "stage": 1,
      "train_config": "configs/experiments/finetune_tray_stage1.json",
      "transfer_config": "configs/transfer/finetune_stage1.yaml",
      "train_mode": "tray_adapt",
      "weak_plan": "reports/domains/weak_tray_plan.json",
      "skip_if_missing_plan": true,
      "mamba": true,
      "device": "0",
      "env": {"HARCHOC_EXPORT_DEVICE": "0"},
      "run_name": "finetune_200-3-1_s1",
      "out": "reports/transfer/finetune_queue_finetune_weak_tray_3.json",
      "estimated_minutes": 90,
      "hyperparams": {
        "epochs": 25,
        "lr": 0.001,
        "imgsz": 1280,
        "batch": 1,
        "freeze_backbone": true,
        "patience": 10
      },
      "rationale": "Weak-tray rank #3 from domain_tray_audit_refresh; same stage-1 protocol as finetune_weak_tray_1.",
      "skip_if": {"finetune_out": "reports/transfer/finetune_queue_finetune_weak_tray_3.json"}
    },
    {
      "id": "finetune_weak_tray_1_s2",
      "kind": "finetune_tray",
      "backlog": ["P1-FINETUNE-TRAY"],
      "tray_key": "3a5-9",
      "stage": 2,
      "stage1_run_name": "finetune_3a5-9_s1",
      "train_config": "configs/experiments/finetune_tray_stage2.json",
      "transfer_config": "configs/transfer/finetune_stage2.yaml",
      "train_mode": "tray_adapt",
      "mamba": true,
      "device": "0",
      "env": {"HARCHOC_EXPORT_DEVICE": "0"},
      "run_name": "finetune_3a5-9_s2",
      "out": "reports/transfer/finetune_queue_finetune_weak_tray_1_s2.json",
      "estimated_minutes": 90,
      "hyperparams": {
        "epochs": 25,
        "lr": 0.0005,
        "imgsz": 1280,
        "batch": 1,
        "freeze_backbone": false,
        "patience": 10
      },
      "rationale": "Stage-2 full unfreeze after finetune_weak_tray_1; base_weights runs/transfer/finetune_3a5-9_s1/weights/best.pt.",
      "skip_if": {"finetune_out": "reports/transfer/finetune_queue_finetune_weak_tray_1_s2.json"},
      "notes": "Requires stage-1 best.pt at runs/transfer/finetune_3a5-9_s1/weights/best.pt (queue resolves via stage1_run_name when base_weights omitted)."
    },
    {
      "id": "finetune_weak_tray_2_s2",
      "kind": "finetune_tray",
      "backlog": ["P1-FINETUNE-TRAY"],
      "tray_key": "350",
      "stage": 2,
      "stage1_run_name": "finetune_350_s1",
      "train_config": "configs/experiments/finetune_tray_stage2.json",
      "transfer_config": "configs/transfer/finetune_stage2.yaml",
      "train_mode": "tray_adapt",
      "mamba": true,
      "device": "0",
      "env": {"HARCHOC_EXPORT_DEVICE": "0"},
      "run_name": "finetune_350_s2",
      "out": "reports/transfer/finetune_queue_finetune_weak_tray_2_s2.json",
      "estimated_minutes": 90,
      "hyperparams": {
        "epochs": 25,
        "lr": 0.0005,
        "imgsz": 1280,
        "batch": 1,
        "freeze_backbone": false,
        "patience": 10
      },
      "rationale": "Stage-2 full unfreeze after finetune_weak_tray_2; base_weights runs/transfer/finetune_350_s1/weights/best.pt.",
      "skip_if": {"finetune_out": "reports/transfer/finetune_queue_finetune_weak_tray_2_s2.json"}
    },
    {
      "id": "finetune_weak_tray_3_s2",
      "kind": "finetune_tray",
      "backlog": ["P1-FINETUNE-TRAY"],
      "tray_key": "200-3-1",
      "stage": 2,
      "stage1_run_name": "finetune_200-3-1_s1",
      "train_config": "configs/experiments/finetune_tray_stage2.json",
      "transfer_config": "configs/transfer/finetune_stage2.yaml",
      "train_mode": "tray_adapt",
      "mamba": true,
      "device": "0",
      "env": {"HARCHOC_EXPORT_DEVICE": "0"},
      "run_name": "finetune_200-3-1_s2",
      "out": "reports/transfer/finetune_queue_finetune_weak_tray_3_s2.json",
      "estimated_minutes": 90,
      "hyperparams": {
        "epochs": 25,
        "lr": 0.0005,
        "imgsz": 1280,
        "batch": 1,
        "freeze_backbone": false,
        "patience": 10
      },
      "rationale": "Stage-2 full unfreeze after finetune_weak_tray_3; base_weights runs/transfer/finetune_200-3-1_s1/weights/best.pt.",
      "skip_if": {"finetune_out": "reports/transfer/finetune_queue_finetune_weak_tray_3_s2.json"}
    },
    {
      "id": "head_roi_eval_smoke",
      "kind": "head_roi_eval",
      "backlog": ["P2-HEAD-ROI", "P2-HEAD-ROI-EVAL"],
      "eval_only": true,
      "estimated_minutes": 15,
      "mamba": true,
      "split_file": "data/splits/test.txt",
      "weights": "models/best2.pt",
      "device": "0",
      "env": {"HARCHOC_EXPORT_DEVICE": "0"},
      "out": "reports/hsp/head_roi_eval_smoke.json",
      "locked_conf_from": "reports/hsp/threshold_val.json",
      "notes": "GT-union head ROI mask on preds @ val-locked conf via scripts/head_roi_eval.py (export + masked counting)."
    }
  ]
}
