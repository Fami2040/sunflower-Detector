{
  "schema_version": "experiments.v1",
  "dataset": {
    "manifest": "data/manifest.json",
    "default_dataset_name": "sunflower-cvat-2500"
  },
  "run": {
    "kind": "threshold_sweep",
    "gt_json": "reports/hsp/gt_val.json",
    "preds_json": "reports/hsp/preds_val.json",
    "out": "reports/hsp/threshold_val.json",
    "csv_out": "reports/hsp/threshold_val.csv",
    "tmin": 0.01,
    "tmax": 0.6,
    "steps": 60,
    "select": "min_count_mae",
    "iou": 0.5
  }
}
